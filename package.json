{
  "name": "hotdash",
  "version": "0.1.0",
  "description": "Chlk founder dashboard.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "TZ=UTC vitest run",
    "test:tz": "TZ=America/Chicago vitest run src/lib/clock.test.ts src/lib/kpis.test.ts src/lib/sales-opportunities.test.ts src/components/metrics src/components/sales-opportunities",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screens": "SCREENSHOTS=1 playwright test e2e/workplace-screens.spec.ts",
    "screens:home": "SCREENSHOTS=1 playwright test e2e/home-screens.spec.ts",
    "screens:metrics": "SCREENSHOTS=1 playwright test e2e/metrics-screens.spec.ts",
    "screens:sales": "SCREENSHOTS=1 playwright test e2e/sales-opportunities-screens.spec.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.1.2",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.33.0"
