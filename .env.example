# --- CRM ---------------------------------------------------------------------
# Everything here is optional: with no values set, the CRM runs on the seeded
# demo data (pnpm crm:seed) and shows the integrations as "not configured".

# SQLite file backing the CRM (cases, contacts, notes, sync state).
DATABASE_PATH=./data/crm.db

# 32+ random bytes (openssl rand -hex 32). Encrypts the stored Google OAuth
# tokens at rest — required before connecting Gmail.
APP_SECRET=

# Google OAuth client for read-only Gmail access (docs/CRM-SETUP.md §1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/crm/google/callback
# Optional comma-separated send-as addresses that also count as "you".
FOUNDER_ALIASES=
# How far back the first Gmail sync reaches: a duration (30d, 8m, 2y) or an
# absolute date (2026-01-01). A date does not drift as time passes.
GMAIL_INITIAL_SYNC_WINDOW=30d

# Stripe restricted key (rk_...) with Customers + Subscriptions read access.
STRIPE_API_KEY=

# Optional read-only Postgres URL for enriching contacts from the Chlk app DB.
SUPABASE_DB_URL=
# Which Chlk profiles become contacts when not already in the CRM:
#   team  everyone on a staff account (default)
#   all   every profile with an email
#   none  only fill in contacts that already exist
SUPABASE_CREATE_CONTACTS=team

# Sync intervals for the in-process scheduler.
SYNC_GMAIL_INTERVAL_SEC=120
SYNC_STRIPE_INTERVAL_SEC=900
SYNC_SUPABASE_INTERVAL_SEC=3600
# Set to 1 to disable automatic syncing (manual Refresh buttons still work).
DISABLE_SYNC_SCHEDULER=
