# Names only. Never commit a value; real values live in Vercel (set through Coulson).
#
# Dashboard login gate (docs/dashboard-gate.md). Leave BOTH empty and the
# dashboard is open (local dev and CI). Set BOTH to lock every page and /api
# route. Setting only one locks everything and /unlock says it's misconfigured.
DASHBOARD_LOGIN_EMAIL=
DASHBOARD_GATE_SECRET=

# CRM persistence, cron authentication, and encrypted token key.
# Neon Marketplace supplies DATABASE_URL automatically; CRM_DATABASE_URL is
# an optional explicit override for this CRM.
CRM_DATABASE_URL=
CRON_SECRET=
CRM_TOKEN_SECRET=

# Optional CRM-specific overrides. When empty, the CRM reuses the dashboard's
# existing GMAIL_CLIENT_ID/GMAIL_CLIENT_SECRET/GMAIL_REFRESH_TOKEN/GMAIL_MAILBOX,
# STRIPE_READONLY_KEY, and SUPABASE_READONLY_DB_URL connections.
CRM_GOOGLE_CLIENT_ID=
CRM_GOOGLE_CLIENT_SECRET=
CRM_GOOGLE_REDIRECT_URI=http://localhost:3000/api/crm/google/callback
CRM_FOUNDER_ALIASES=
# Duration (`120d`) or Gmail date (`after:2026/06/01`) for full Gmail backfill.
CRM_GMAIL_INITIAL_SYNC_WINDOW=30d
# Set to 1 for one run that clears the Gmail history cursor (cron or ?full=1).
CRM_GMAIL_FORCE_FULL_RESYNC=
# Lower this (e.g. 2) during large backfills to reduce Gmail quota spikes.
CRM_GMAIL_FETCH_CONCURRENCY=
CRM_STRIPE_API_KEY=
CRM_SUPABASE_DB_URL=
