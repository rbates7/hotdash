# --- App -------------------------------------------------------------------
# Login password. Leave empty to disable the login gate entirely (local use).
APP_PASSWORD=
# 32+ random bytes, e.g. `openssl rand -hex 32`. Signs the session cookie AND
# encrypts the stored Google OAuth tokens — treat it like a private key.
APP_SECRET=
# SQLite database location (created on first run).
DATABASE_PATH=./data/hotdash.db

# --- Google / Gmail (docs/SETUP.md §1) --------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Optional comma-separated send-as addresses that also count as "you"
# for inbound/outbound direction detection.
FOUNDER_ALIASES=
# How far back the first Gmail sync reaches (Gmail search syntax duration).
GMAIL_INITIAL_SYNC_WINDOW=30d

# --- Stripe (docs/SETUP.md §2) ----------------------------------------------
# Restricted key (rk_...) with read-only access to Customers + Subscriptions.
STRIPE_API_KEY=

# --- Supabase enrichment (docs/SETUP.md §3) ---------------------------------
# Optional read-only Postgres connection string for the Chlk app database.
# Leave empty to disable enrichment (sync shows "Not configured").
SUPABASE_DB_URL=

# --- Sync scheduler ---------------------------------------------------------
SYNC_GMAIL_INTERVAL_SEC=120
SYNC_STRIPE_INTERVAL_SEC=900
SYNC_SUPABASE_INTERVAL_SEC=3600
# Set to 1 to disable the in-process scheduler (rely on the Refresh buttons
# or an external cron hitting POST /api/sync/all).
DISABLE_SYNC_SCHEDULER=
