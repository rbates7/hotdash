# Sign-in lock. Copy to .env.local (never commit it) or set in Vercel.
# If any of these is missing or invalid, nobody can sign in and /sign-in says
# "Sign-in isn't configured".

# The one email allowed to sign in (case-insensitive).
ADMIN_EMAIL=you@example.com

# From `pnpm auth:hash`. Format: scrypt$N$r$p$saltB64$hashB64
# In .env files escape every $ as \$ (Next expands $NAME even in quotes).
# In Vercel, paste the raw value.
ADMIN_PASSWORD_HASH=scrypt\$32768\$8\$1\$REPLACE_WITH_SALT\$REPLACE_WITH_HASH

# At least 32 random characters; signs the session cookie. Generate with:
#   openssl rand -base64 48
# Changing it signs everyone out.
AUTH_SECRET=replace-with-at-least-32-random-characters
